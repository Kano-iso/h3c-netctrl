FROM node:20-alpine

WORKDIR /app

# 替换为淘宝镜像源加速
RUN npm config set registry https://registry.npmmirror.com/

# 复制前端 package.json（build context = 项目根）
COPY frontend/package*.json ./
RUN npm install

# 复制前端源码
COPY frontend/ .

# v2.5：解决 v2.3 EACCES 遗留——node_modules 由 root 拥有，node 用户无写权限
# chown 后 vitest 写临时文件不再报 EACCES
RUN chown -R node:node /app

# 复制 docs（让 QA-GUIDE 链接在容器内可访问）
COPY docs/ /opt/docs/

# 复制 entrypoint 脚本（输出 QA-GUIDE 文档链接 banner）
COPY backend/entrypoint-qa.sh /usr/local/bin/entrypoint-qa.sh
RUN chmod +x /usr/local/bin/entrypoint-qa.sh

# v2.5：加 test:unit（vitest）步骤
# 顺序：lint → type-check → build → test:unit
# - lint 不过 → type-check/build/test:unit 不跑
# - type-check 不过 → build/test:unit 不跑
# - build 不过 → test:unit 不跑
ENTRYPOINT ["entrypoint-qa.sh"]
CMD ["sh", "-c", "npm run lint && npm run type-check && npm run build && npm run test:unit"]
