# dnsmasq.conf.template — DHCP + TFTP 二合一配置（v3.1.1 改造）
# 由 ztp-stack/entrypoint.sh 渲染 env vars 后写入 /etc/dnsmasq.conf
#
# v3.1.1 关键设计变更（user 2026-07-18 拍板）:
# - DHCP range: .151-.190（v3.1.0 的 .200-.250 → v3.1.1 缩小到 40 IP + offset 50 跨池映射）
# - static 池: .101-.140（autocfg.cfg 推的 static IP，物理 OOB 口写入）
# - gap: .141-.150（10 IP 安全余量）
# - 删除 mac-binding（v3.1.0 调研方向，user 2026-07-18 明确反对）
# - 删除 dhcp-leasefile 持久化（v3.1.0 调研方向，user 2026-07-18 明确反对）
# - 删除 dhcp-host=MAC,IP,infinite（v3.1.0 调研方向，user 2026-07-18 明确反对）

# ============================================================
# DHCP server
# ============================================================
# DHCP 池: .151-.190（40 IP，设备首启"一无所知"时分配临时地址）
# 跨池映射: DHCP .X → autocfg.cfg 推 .X-50（static 池 .101-.140）
# gap: .141-.150（10 IP 安全余量，dnsmasq 不分配）
# 实际场景: host network 模式下, dnsmasq 默认监听所有接口
# 详细排查: tail -f /var/log/dnsmasq.log
dhcp-range=${ZTP_DHCP_RANGE_START},${ZTP_DHCP_RANGE_END},${ZTP_DHCP_LEASE}

# DHCP option 66 (TFTP server) + 67 (bootfile name)
dhcp-option=66,${ZTP_HOST_IP}
dhcp-option=67,autocfg.cfg

# 默认网关（按需调整）
# dhcp-option=3,192.168.100.1
# DNS（按需调整, 默认不分配）
# dhcp-option=6,192.168.100.1

# v3.1.1 明确不做（user 2026-07-18 拍板反对）:
# - dhcp-host=MAC,IP,infinite（mac-binding）—— 设备切到 static IP 后永久脱离 DHCP 池，不需要
# - dhcp-leasefile=/var/lib/misc/dnsmasq.leases（lease 持久化）—— 容器重启后 lease 丢失是设计选择

# ============================================================
# TFTP server
# ============================================================
enable-tftp
tftp-root=/var/tftp

# 兼容 H3C V7 TFTP 客户端（部分老版本不支持 RFC 2348 blocksize）
tftp-no-blocksize

# TFTP 安全（仅允许 /var/tftp 目录）
# tftp-secure

# ============================================================
# Log
# ============================================================
log-queries
log-dhcp
log-facility=-  # 写到 stderr, 由 docker logs 收集（不用落盘, 避免污染容器）

# ============================================================
# Misc
# ============================================================
# 关闭 DNS server（只用 DHCP + TFTP, 不污染网络 DNS）
port=0

# 不读取 /etc/resolv.conf 或 /etc/hosts
no-resolv
no-hosts
