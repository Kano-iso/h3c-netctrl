#
# H3C V7 自动配置 - autocfg.cfg
# 平台: {{ platform }} ({{ platform_long }})
# 生成时间: {{ ztp_date }}
# 用途: 新设备首次上线 / 已有设备恢复上线基础配置（sysname + OOB VRF/IP + SSH + NETCONF + 凭据）
# IP 映射: offset 50 跨池（DHCP .151-.190 ↔ static .101-.140，gap .141-.150）
# 凭据: python / Admin123!@#（项目主账密统一，user 2026-07-18 拍板）
# 模板版本: v3.1.1（zinja2 通用 + 2 平台条件分支 + HCL 子分支）
#

# === 系统名 ===
sysname {{ sysname }}

# === 关闭首次登录改密 ===
# HCL T7064P15-hcl：login-password-change disable（HCL 独有，prod Unrecognized）
# 其他平台：change-password first-login enable（no-op 安全）
{% if hcl_t7064p15 %}
password-control login-password-change disable
{% else %}
password-control change-password first-login enable
{% endif %}

# === OOB 管理 VRF ===
ip vpn-instance mgt
quit

# === 物理 OOB 口 static IP（offset 50 跨池映射）===
# LSTN (S6850) = M-GigabitEthernet0/0/0
# RSTN (V9850) = M-GigabitEthernet0/0/0（MGE0/0/0 可作为缩写，但模板写完整名）
# v3.1.1 阶段硬编码 .101（PoC 验证单设备），公式化映射由 v3.1.2 接入多设备时实现
{% if platform == 'lstn' %}
interface M-GigabitEthernet0/0/0
 ip binding vpn-instance mgt
 ip address {{ mgmt_ip }} 255.255.255.0
quit
{% elif platform == 'rstn' %}
interface M-GigabitEthernet0/0/0
 ip binding vpn-instance mgt
 ip address {{ mgmt_ip }} 255.255.255.0
quit
{% endif %}

# === SSH 服务 ===
ssh server enable
{% if platform == 'lstn' %}
ssh server authentication-timeout 300
{% endif %}

# === 本地用户（项目主账密 python/Admin123!@#，统一 network-admin，禁止第二账号）===
local-user {{ admin_user }} class manage
 password simple {{ admin_pass }}
 service-type ssh terminal
 authorization-attribute user-role network-admin
 authorization-attribute user-role level-15
quit

# === VTY 配置（SSH only，禁用 telnet）===
{% if platform == 'rstn' %}
line vty 0 4
 authentication-mode scheme
 user-role network-operator
 protocol inbound ssh
quit
line vty 5 63
 user-role network-operator
quit
{% else %}
user-interface vty 0 15
 authentication-mode scheme
 protocol inbound ssh
quit
{% endif %}

# === NETCONF 服务 ===
# S6850（.5 prod + .177 hcl）默认已 enable，no-op 安全
# V9850（.26）默认已 enable，no-op 安全
netconf ssh server enable

# === 持久化 ===
save force
