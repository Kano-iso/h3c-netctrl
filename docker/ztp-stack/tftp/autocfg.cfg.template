#
# H3C V7 自动配置 - autocfg.cfg
# 生成: ztp-stack 容器 entrypoint.sh 渲染 env vars 后写入
# 用途: 新设备首次上线最小基础配置
#
# 关键约束（user 2026-07-17 02:13 明确）:
# - ✅ 只做基础配置: SSH 22 + NETCONF 830 + 凭据 + 带外 IP
# - ❌ 不做业务配置: VPC / 端口绑定 / 路由协议 / 业务 VLAN
# - ❌ 不做配置联动: ZTP 完成后由 controller 继续推业务配置
#
# 模板变量（由 env vars 注入）:
# - ${ZTP_SYSNAME}:     设备 sysname
# - ${ZTP_MGMT_IP}:     带外管理 IP
# - ${ZTP_MGMT_MASK}:   子网掩码
# - ${ZTP_MGMT_GATEWAY}: 管理网关
# - ${ZTP_ADMIN_USER}:  SSH 登录用户名
# - ${ZTP_ADMIN_PASS}:  SSH 登录密码（明文, 短期方案）
#

# ============================================================
# 设备身份
# ============================================================
sysname ${ZTP_SYSNAME}

# ============================================================
# 带外管理接口（vlan 1 + Vlan-interface1）
# ============================================================
vlan 1

interface Vlan-interface1
 ip address ${ZTP_MGMT_IP} ${ZTP_MGMT_MASK}
 ip gateway ${ZTP_MGMT_GATEWAY}  # 部分 H3C 平台不支持 ip gateway, 失败不影响
 #
 quit

# ============================================================
# SSH 服务（vty 0-15）
# ============================================================
ssh server enable
ssh server authentication-timeout 300

# SSH 登录用户（password 简写，ZTP 阶段临时方案）
local-user ${ZTP_ADMIN_USER} class manage
 password simple ${ZTP_ADMIN_PASS}
 service-type ssh terminal
 authorization-attribute user-role network-admin
 authorization-attribute user-role level-15
quit

# vty 0-15 启用 SSH
user-interface vty 0 15
 authentication-mode scheme
 protocol inbound ssh
quit

# ============================================================
# NETCONF 服务
# ============================================================
netconf ssh server enable

# ============================================================
# 保存配置（关键: 设备 reboot 后配置必须保留）
# ============================================================
save force

# ============================================================
# ZTP 完成标记（可选, 便于后续 ZTP 状态检测）
# ============================================================
# 设备启动后, controller 可通过 `display current-configuration | include ztp_done` 检测
# event ZTP_DONE timestamp
