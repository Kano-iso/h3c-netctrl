# H3C NetCtrl 环境变量配置
# 复制此文件为 .env 并填入实际值

# 日志级别: INFO / DEBUG
LOG_LEVEL=INFO

# Fernet 加密密钥 (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# SQLite 数据库路径
DB_PATH=./data/dev.db

# 后端服务端口
BACKEND_PORT=8000

# ============================================================
# 配置备份（v2.1.x patch 灰度，前端延后到 v2.2）
# 备份文件实际存储路径，对应 docker-compose.dev.yml 中的 volume 挂载
# BACKUP_KEEP: 每设备保留未锁定份数（锁定备份永久保留不参与轮转）
# ============================================================
BACKUP_DIR=/data/backups
BACKUP_KEEP=5
