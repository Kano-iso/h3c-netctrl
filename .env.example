# H3C NetCtrl 环境变量配置
# 复制此文件为 .env 并填入实际值

# 日志级别: INFO / DEBUG
LOG_LEVEL=INFO

# Fernet 加密密钥 (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# SQLite 数据库路径
# v2.6.1 fix-backup-data-integrity Task 3a: 默认值改绝对路径 /app/data/data.db
# - 容器内（split 模式）走默认值，无需设置
# - monolith 模式本地开发机用相对路径：DB_PATH=./data/dev.db
DB_PATH=./data/dev.db

# 后端服务端口
BACKEND_PORT=8000

# ============================================================
# 配置备份（v2.1.x patch 灰度，前端延后到 v2.2）
# 备份文件实际存储路径，对应 docker-compose.dev.yml 中的 volume 挂载
# BACKUP_KEEP: 每设备保留总份数（含锁定）。锁定优先保留不被轮转删（v2.3.1 patch 改）
# ============================================================
BACKUP_DIR=/data/backups
BACKUP_KEEP=5

# ============================================================
# v2.4.2 默认设备凭据（ops-toolkit 容器自动注入）
# ops-toolkit 工具默认凭据来源：所有排错脚本会从 DEVICE_USERNAME / DEVICE_PASSWORD 读
# 这样调用方不需要 -e 传参或 --user/--pass 暴露密码
# 真实密码请填在 .env（已加入 .gitignore），不要提交到 git
# ============================================================
# DEVICE_USERNAME=python
# DEVICE_PASSWORD=your-device-password-here

# ============================================================
# v2.6.1 资产陈旧阈值（fix-asset-stale-status）
# 超过 ASSET_STALE_HOURS 小时未更新的 online 资产视为"陈旧"：
# - data 容器启动时主动降级 status='offline'（幂等）
# - dashboard 读取时单独计 stale 字段
# ASSET_STALE_HOURS=0.01 调试用（36 秒立即降级）
# ASSET_STALE_ENABLED=False 关闭降级（兼容历史数据）
# ============================================================
ASSET_STALE_HOURS=1
ASSET_STALE_ENABLED=True

# ============================================================
# v2.4.1 容器拆分（v2.5 默认翻转：split 模式默认，core 模式需 --profile core）
# split 模式（默认）：ctrl / config / data 3 容器
# core 模式（--profile core）：backend 单容器（monolith）
# ============================================================
# 内部 API 通信 token（3 容器共享同一密钥）
INTERNAL_API_TOKEN=dev-token

# 3 容器寻址（Docker 内部 DNS，容器名:端口）
INTERNAL_CTRL_URL=http://ctrl:8000
INTERNAL_CONFIG_URL=http://config:8000
INTERNAL_DATA_URL=http://data:8000

# 前端 API 模式（v2.5）：split（默认，3 容器）| core（monolith，需 --profile core）
# frontend/.env 也需同步设置（容器挂载读的是 frontend/.env）
VITE_API_MODE=split

# ============================================================
# v3.0 SDN/VPC 编号分配（sdn-vpc-model-and-foundation）
# 所有起始值避开前 1000 号段（RESERVED_THRESHOLD=1000）
# - RD/RT 格式：{base}:{tenant_id}（如 100:1）
# - L3VNI 默认从 10000 起，L2VNI 默认从 20000 起
# - Vsi-interface 默认从 1000 起，VLAN 默认从 2000 起
# ============================================================
SDN_RD_BASE=100
SDN_RT_BASE=100
SDN_L3VNI_START=10000
SDN_L2VNI_START=20000
SDN_VSI_IF_START=1000
SDN_VLAN_START=2000

# ============================================================
# v3.1 ZTP 调研 T3 基建：ztp-server 容器 (DHCP + TFTP 二合一)
# 容器: docker compose -f docker-compose.dev.yml --profile ops up -d ztp-server
# 关键约束: 仅受控局域网启用, 避免外部 DHCP 干扰
# ============================================================
# 宿主机 IP（TFTP server 暴露地址, 设备 dhcp-option=66 收到这个 IP）
# 默认值: 192.168.100.4 (本机常用 IP)
# ZTP_HOST_IP=192.168.100.4
# DHCP 分配范围（避开 .1-.199 已用, 默认 .200-.250）
# ZTP_DHCP_RANGE_START=192.168.100.200
# ZTP_DHCP_RANGE_END=192.168.100.250
# ZTP_DHCP_LEASE=12h
# 设备自动配置最小基础配置（autocfg.cfg 模板渲染变量）
# ZTP_SYSNAME=ztp-device
# ZTP_MGMT_IP=192.168.100.10
# ZTP_MGMT_MASK=255.255.255.0
# ZTP_MGMT_GATEWAY=192.168.100.1
# ZTP_ADMIN_USER=admin
# ZTP_ADMIN_PASS=admin
# （注: ZTP 阶段用明文 password, ZTP 完成后 controller 立即 SSH 推 password hash 覆盖）

# v3.0 config 容器启动行为
# - 默认 false：跳过 alembic 升级（运维侧预先跑过或 db 已就绪）
# - true：启动时自动跑 alembic upgrade head（仅当 db schema 与代码同步时）
# config 容器在 v3 split 模式下仅持有 SDN 表，旧的 monolith 表（assets/logs）不在 config.db
# 默认情况：运维在 config 容器首次启动前手动跑 alembic upgrade head
CONFIG_AUTO_MIGRATE=false
