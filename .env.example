# H3C NetCtrl 环境变量配置
# 复制此文件为 .env 并填入实际值

# 日志级别: INFO / DEBUG
LOG_LEVEL=INFO

# Fernet 加密密钥 (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# SQLite 数据库路径
DB_PATH=./data/dev.db

# 后端服务端口
BACKEND_PORT=8000

# 默认设备配置 (V1.0 单设备)
DEVICE_HOST=192.168.100.100
DEVICE_PORT=830
DEVICE_USERNAME=python
DEVICE_PASSWORD=Admin123!@#
