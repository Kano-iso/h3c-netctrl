    "duplicate_request": {
      "request": { "method": "POST", "path": "/api/sdn/vpcs/1/access", "body": { "idempotency_key": "op-9f3a-0001", "plan_id": "plan-0001-xxxx", "device_id": 5, "if_index": 2, "interface_name": "GigabitEthernet1/0/2", "service_instance": 3200, "expected_host_ip": "10.1.1.2", "auto_apply": true } },
      "response": {
        "success": true,
        "data": { "operation_id": 100, "status": "awaiting_wiring", "duplicate": true, "note": "相同幂等键 + 相同授权 scope + 相同归一化请求 + 相同 plan_id 返回已存在操作，不重复建绑定/下发" }
      }
    },
