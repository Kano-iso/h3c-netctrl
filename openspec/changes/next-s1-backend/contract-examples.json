{
  "_meta": {
    "kind": "proposed-contract",
    "note": "本文件是 S1 终端接入闭环的后端契约样本，供前端理解和 fixture 使用。S1-005 已落地 endpoints（见 backend/app/routers/sdn_access.py），状态、对象 ID、证据时间与操作归属已做自洽示例。",
    "not_implemented": false,
    "base_endpoints": {
      "preview": "POST /api/sdn/vpcs/{vpc_id}/access-preview",
      "start": "POST /api/sdn/vpcs/{vpc_id}/access",
      "operation": "GET /api/sdn/operations/{operation_id}",
      "complete": "POST /api/sdn/operations/{operation_id}/complete",
      "withdraw": "POST /api/sdn/operations/{operation_id}/withdraw",
      "overview": "GET /api/sdn/vpcs/{vpc_id}/access-overview"
    },
    "four_dimension_status": {
      "execution": "deployment.status: pending|running|success|failed|unknown（attempt/unit 逐单元状态另见 attempt_unit_states）",
      "config_readback": "校验快照中是否有本次操作后的配置回读证据",
      "business_validation": "validation_result: active|degraded|failed|insufficient",
      "evidence": "{ collected_at, cached, source }"
    }
  },
  "examples": {
    "normal_access_awaiting_wiring": {
      "request": {
        "method": "POST",
        "path": "/api/sdn/vpcs/1/access",
        "body": {
          "idempotency_key": "op-9f3a-0001",
          "device_id": 5,
          "if_index": 2,
          "interface_name": "GigabitEthernet1/0/2",
          "service_instance": 3200,
          "expected_host_ip": "10.1.1.2",
          "auto_apply": true
        }
      },
      "response": {
        "success": true,
        "data": {
          "operation_id": 100,
          "operation_type": "terminal_access",
          "status": "awaiting_wiring",
          "execution": "success",
          "vpc": { "id": 1, "name": "研发网络", "status": "expanding", "cidr": "10.1.1.0/24", "gateway_ip": "10.1.1.254", "vni": 20000, "vsi_name": "vpc0001", "vsi_interface": 1000 },
          "tenant": { "id": 1, "name": "研发", "rd": "100:1", "l3_vni": 10000 },
          "device": { "id": 5, "name": "Leaf-04", "host": "192.168.100.5", "sdn_role": "evpn_leaf", "platform": "LSTN" },
          "binding": { "id": 10, "device_id": 5, "vpc_id": 1, "if_index": 2, "interface_name": "GigabitEthernet1/0/2", "service_instance": 3200, "status": "expanding", "operation_id": 100, "created_at": "2026-09-07T10:00:02Z" },
          "deployments": [
            { "id": 200, "action": "port_bind", "unit": "port-bind", "status": "success", "operation_id": 100, "created_at": "2026-09-07T10:00:02Z" }
          ],
          "next_status": "awaiting_wiring",
          "expected_host_ip": "10.1.1.2"
        }
      }
    },
    "normal_validation_success": {
      "request": { "method": "POST", "path": "/api/sdn/operations/100/complete", "body": { "expected_host_ip": "10.1.1.2" } },
      "response": {
        "success": true,
        "data": {
          "operation_id": 100,
          "status": "succeeded",
          "attempt_id": "v-100-1",
          "scope": { "vpc_id": 1, "device_id": 5, "binding_id": 10, "config_version": "deployment-200" },
          "execution": "success",
          "config_readback": { "ok": true, "evidence": ["display l2vpn vsi name vpc0001 verbose", "display current-configuration interface GigabitEthernet1/0/2"] },
          "business_validation": { "result": "active", "details": { "bgp_peer_established": true, "vsi_up": true, "type2_present": true, "arp_present": true } },
          "ping": { "command": "ping -a 10.1.1.254 -vpn-instance sdn_l3vpn 10.1.1.2", "success": true },
          "limitations": ["本地网关探测通过不代表跨 Leaf 端到端成功", "仅证明本地下联可达，不含应用层通信"],
          "evidence": { "snapshot_id": 50, "attempt_id": "v-100-1", "collection_started_at": "2026-09-07T10:02:00Z", "collection_completed_at": "2026-09-07T10:02:05Z", "cached": false, "source": "fresh-display-collect", "causal_ok": true, "config_completed_at": "2026-09-07T10:01:00Z" }
        }
      }
    },
    "unknown_and_missing_evidence": {
      "request": { "method": "POST", "path": "/api/sdn/operations/100/complete", "body": { "expected_host_ip": "10.1.1.2" } },
      "response": {
        "success": true,
        "data": {
          "operation_id": 100,
          "status": "awaiting_validation",
          "execution": "success",
          "config_readback": { "ok": true },
          "business_validation": { "result": "insufficient", "details": { "arp_present": false, "type2_present": false, "reason": "未观察到该主机学习信息" } },
          "ping": { "success": false },
          "evidence": { "snapshot_id": 51, "collected_at": "2026-09-07T10:03:00Z", "cached": false, "source": "fresh-display-collect" },
          "note": "采集成功但未发现终端学习证据，判定为证据不足，不代表主机故障"
        }
      }
    },
    "stale_evidence_rejected": {
      "request": { "method": "POST", "path": "/api/sdn/operations/100/complete", "body": { "expected_host_ip": "10.1.1.2", "force_validation": false } },
      "response": {
        "success": true,
        "data": {
          "operation_id": 100,
          "status": "awaiting_validation",
          "evidence": { "snapshot_id": 40, "collected_at": "2026-09-07T09:00:00Z", "cached": true, "source": "cache-hit" },
          "business_validation": { "result": "stale" },
          "error": "旧缓存不能证明本次接入成功，需发起新采集",
          "next_action": "force_validation"
        }
      }
    },
