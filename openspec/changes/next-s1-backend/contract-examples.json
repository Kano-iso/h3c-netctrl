    "partial_failure": {
      "request": { "method": "POST", "path": "/api/sdn/vpcs/1/access", "body": { "idempotency_key": "op-9f3a-0002", "device_id": 5, "if_index": 3, "interface_name": "GigabitEthernet1/0/3", "service_instance": 3201, "expected_host_ip": "10.1.1.3", "auto_apply": true } },
